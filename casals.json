{
  "version": 2,
  "name": "gaas",
  "description": "Governance Operating System-as-a-Service platform",
  "environments": {
    "local": {
      "network": "local",
      "$comment": "Laptop: scripts/local_up.sh --gaas in the realms-gos checkout. Plaintext local-dev identity, no DNS.",
      "dns": {
        "provider": "none"
      },
      "portal_url": "http://${canister:realm-registry-frontend}.localhost:8000",
      "gos_environment": "local",
      "casals_url": "http://${canister:casals-frontend}.localhost:8000",
      "principals": {
        "operator": "$deployer",
        "deployer": "$deployer",
        "admin": "$new_access_code"
      },
      "realms_product": {
        "marketplace_id": "$orchestra:realms-product/marketplace-backend"
      },
      "cycles": {
        "budget_tc": 300
      },
      "can_test_mode": true
    },
    "production": {
      "network": "ic",
      "$comment": "operator is prod-identity (YubiKey). Deploy through an icp delegation from it (`prod-session`, docs/OPERATIONS.md, Hardware keys): the IC sees the same principal. DNS lives in the Cloudflare zone gos.earth; the API token is read from $CLOUDFLARE_API_TOKEN, never written here. The CLI does not write Cloudflare records yet (`reconcile_domains` reports unverifiable): per host add, DNS only (grey cloud), CNAME <host> -> <host>.icp1.io, TXT _canister-id.<host> -> <canister id from bindings>, CNAME _acme-challenge.<host> -> _acme-challenge.<host>.icp2.io, then POST https://icp0.io/custom-domains/v1/<host>.",
      "dns": {
        "provider": "cloudflare",
        "zone": "gos.earth",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "portal_url": "https://gos.earth",
      "gos_environment": "production",
      "casals_url": "https://casals.gos.earth",
      "principals": {
        "operator": "$deployer",
        "$comment": "Unclaimed access-code slot. Whoever redeems it becomes a conductor commander with full access. The code is not stored in this file.",
        "admin": "sha256:54f37582880030555448c7ff7b148ade534eb69df89c922a819189ec711aa9ed",
        "$comment_deployer": "The identity that ran casals up. It is a controller of the governance multisig only.",
        "deployer": "$deployer"
      },
      "realms_product": {
        "marketplace_id": "$orchestra:realms-product/marketplace-backend"
      },
      "cycles": {
        "budget_tc": 40
      },
      "can_test_mode": false
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "store": {
      "$comment": "WASM store",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      },
      {
        "principal": "$principal:admin",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "gaas"
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.8.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig",
        "$deployer"
      ]
    }
  },
  "domains": [
    {
      "host": "gos.earth",
      "canister": "realm-registry-frontend"
    },
    {
      "host": "casals.gos.earth",
      "canister": "casals-frontend"
    }
  ],
  "registry": {
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "release:smart-social-contracts/Casals@v0.7.0:casals_backend.wasm.gz",
        "sha256": "122722ea253d45502ff13fb79e0b5e02c57bb7c5d1e578ee734c0987171cef3a"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "release:smart-social-contracts/Casals@v0.7.0:certified-assets@0.3.0.wasm.gz",
        "sha256": "75df75f39763077fd0333b4ac46ba03b2b23ec313fa85f79a2097bd98bb363d1"
      },
      {
        "family": "ic-frontend",
        "version": "1.0.1",
        "source": "release:smart-social-contracts/ic-frontend@v1.0.1:ic-frontend@1.0.1.wasm.gz",
        "sha256": "feec64ef3ae77608b7399866d678532d4956c09121d06e00fb3e3b57d4ad8939"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.8.0",
        "source": "release:smart-social-contracts/Casals@v0.7.0:orchestration-multisig@1.8.0.wasm.gz",
        "sha256": "4e7c720ebfa77d6c75c4a54d7f8af91f532ce1ec2035f014e39a3396201af924"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "release:smart-social-contracts/file-registry@v0.1.2:file_registry.wasm.gz",
        "sha256": "9e6d85c8bf4695b38c3ae63b62a2636d54c5849073cc97e98e95415e8d1a7d21"
      },
      {
        "family": "orchestration-baton",
        "version": "2.2.0",
        "source": "release:smart-social-contracts/Casals@v0.7.0:orchestration-baton@2.2.0.wasm.gz",
        "sha256": "e57030ea8be9dadb297eaac246d500afd66d50ef6d5e17f3f5a2620d017d56e7"
      },
      {
        "family": "casals-maintenance",
        "version": "1.0.0",
        "source": "release:smart-social-contracts/Casals@v0.7.0:casals-maintenance@1.0.0.wasm.gz",
        "sha256": "7a3e471c7c6d6ff136946dfd89ae770ce7cc98d37e4b4ad7f2a8107d8349b76f"
      },
      {
        "family": "realm-installer",
        "version": "main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.5.0:realm_installer.wasm.gz",
        "sha256": "6d0bf0504fabbe5c5ed9a2e0625678ef3e4e329577e36e701747d673627774c5"
      },
      {
        "family": "realm-registry-backend",
        "version": "main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.5.0:realm_registry_backend.wasm.gz",
        "sha256": "6bf065a1a29b428afe60f991c934fd526873f189b4a5c1f3ec5a33815df1ab02"
      },
      {
        "family": "realm-backend",
        "version": "0.7.0",
        "source": "release:smart-social-contracts/realms-gos@v0.7.0:realm-backend-v0.7.0.wasm.gz",
        "sha256": "db92b17c7359c9a1ca0aacfc9694152d581af708e6d8c3156822a69669953aad"
      }
    ],
    "bundles": [
      {
        "path": "frontend/realm-registry-frontend/main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.5.0:realm_registry_frontend.tar.gz",
        "sha256": "8411ef7cdd24689de9342ef31afb5a163af3636849fa6d86cf1d9004c60ac34d"
      },
      {
        "path": "release/realm/0.7.0/frontend",
        "source": "release:smart-social-contracts/realms-gos@v0.7.0:realm-frontend-v0.7.0.tar.gz",
        "sha256": "e60ee46b07e48adf65eea4d13a290a43069250d55ce7a7d412f036b32f63327d"
      },
      {
        "path": "frontend/casals-ui/main",
        "source": "release:smart-social-contracts/Casals@v0.7.0:casals_frontend.tar.gz",
        "sha256": "394c6325e24139ebace527d0e9347e14700822609a07d29821b3a17d2714a330"
      }
    ]
  },
  "sections": [
    {
      "name": "Infra",
      "description": "Realm installer, realm registry (the gos.earth portal) and the platform file registry.",
      "stands": [
        {
          "name": "file-registry",
          "description": "Platform artifact buffer (deployment temporary artifacts, such as manifests, etc.)",
          "canisters": [
            {
              "name": "file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "$comment": "Packages the installer fetches (ext/\u2026, codex/\u2026) are published here by the operator with `realms files publish`; controllers cannot upload.",
                  "method": "grant_publish",
                  "args": {
                    "namespace": "*",
                    "principal": "$principal:operator"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "*": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "$comment": "Portal branding uploads are signed by the end user, who becomes publisher of the fresh namespace (see realm_registry_frontend branding-upload.js).",
                  "method": "set_config",
                  "args": {
                    "auto_grant_publishers": true
                  },
                  "converged_when": {
                    "query": "get_config",
                    "equals_args": true
                  }
                },
                {
                  "$comment": "First-party listings on the Realms marketplace point at this registry; its review_listing stamps approvals here, so it must be an _approvers publisher.",
                  "method": "grant_publish",
                  "args": {
                    "namespace": "_approvers",
                    "principal": "$env.realms_product.marketplace_id"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "_approvers": [
                        "$env.realms_product.marketplace_id"
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "installer",
          "canisters": [
            {
              "name": "realm-installer",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-installer@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "registry_backend_id": "$canister:realm-registry-backend",
                    "file_registry_id": "$canister:file-registry",
                    "gos_environment": "$env.gos_environment",
                    "casals_canister_id": "$self",
                    "casals_section": "Deployments",
                    "portal_url": "$env.portal_url",
                    "provision_via_casals": true
                  },
                  "converged_when": {
                    "query": "get_installer_config",
                    "equals_args": true
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "realm-registry",
          "canisters": [
            {
              "name": "realm-registry-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-registry-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "portal_url": "$env.portal_url",
                    "installer_id": "$canister:realm-installer",
                    "casals_frontend_canister_id": "$canister:casals-frontend",
                    "can_test_mode": "$env.can_test_mode"
                  },
                  "converged_when": {
                    "query": "get_env_config",
                    "equals_args": true
                  }
                }
              ]
            },
            {
              "name": "realm-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "ic-frontend@1.0.1",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/realm-registry-frontend/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_registry_backend:\"$stand.backend\",realm_installer:\"$canister:realm-installer\",file_registry:\"$canister:file-registry\",casals_backend:\"$canister:casals-backend\",network:\"$env.network\",portal_url:\"$env.portal_url\",casals_url:\"$env.casals_url\",gos_environment:\"$env.gos_environment\"};\n"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Deployments",
      "description": "Realm stands. The installer mints one with create_stand; the conductor builds it from this template and hands the backend, frontend, and quarters to the stand baton. A realm grows itself: its backend (a stand commander) calls create_stand for the next quarter.",
      "arrangements": {
        "stand_template": {
          "name_pattern": "*",
          "created_by": "$canister:realm-installer",
          "baton": {
            "commanders": [
              {
                "principal": "$multisig",
                "weight": 2
              },
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend",
              "quarter"
            ],
            "hand_off": "sole"
          },
          "commanders": [
            {
              "principal": "$stand.backend",
              "permissions": "stand.create"
            }
          ],
          "canisters": [
            {
              "name": "{stand}-baton",
              "cycles": {
                "min_balance_tc": 5
              },
              "kind": "backend",
              "mode": "managed",
              "wasm": "orchestration-baton@2.2.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "{stand}-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-backend@0.7.0",
              "install_arg": "(\"$canister:realm-installer\")",
              "controllers": [
                "$stand.baton",
                "$multisig",
                "$this"
              ]
            },
            {
              "name": "{stand}-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "ic-frontend@1.0.1",
              "controllers": [
                "$stand.baton",
                "$stand.backend"
              ],
              "grants": [
                {
                  "principal": "$stand.backend",
                  "permission": "Commit"
                }
              ],
              "content": "release/realm/0.7.0/frontend",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_backend:\"$stand.backend\",internet_identity:\"https://identity.ic0.app\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            },
            {
              "name": "{stand}-quarter-{n}",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-backend@0.7.0",
              "install_arg": "(\"\")",
              "optional": true,
              "controllers": [
                "$stand.baton",
                "$multisig",
                "$this"
              ]
            }
          ]
        }
      },
      "stands": []
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "backend": {
      "min_balance_tc": 1.0
    },
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
