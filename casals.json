{
  "version": 2,
  "name": "gaas",
  "description": "GaaS platform: conductor, governance multisig, realm installer, realm registry (portal), and the realm stand template the installer mints from. `casals up casals.json -e <env>` builds all of it from scratch and reconciles it afterwards.",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "portal_url": "http://${canister:realm-registry-frontend}.localhost:8000",
      "portal_host": "",
      "ii_alternative_origins": "{\"alternativeOrigins\": [\"http://${canister:realm-registry-frontend}.localhost:8000\"]}",
      "can_test_mode": true,
      "realms_product": {
        "$comment": "Realms product canisters live on the Realms GOS conductor (../realms/casals.json); none locally.",
        "marketplace_id": "",
        "nft_canister_id": "",
        "shared_tokens": {}
      },
      "test_flags": {
        "test_mode": true,
        "ii_bypass": true,
        "user_self_registration": true,
        "demo_data": true,
        "skip_terms": true
      },
      "principals": {
        "operator": "$deployer"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 300
      }
    },
    "production": {
      "network": "ic",
      "dns": {
        "provider": "cloudflare",
        "zone": "gos.earth",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "portal_url": "https://gos.earth",
      "portal_host": "gos.earth",
      "ii_alternative_origins": "{\"alternativeOrigins\": [\"https://gos.earth\", \"https://${canister:realm-registry-frontend}.icp0.io\"]}",
      "can_test_mode": false,
      "test_flags": {
        "ii_bypass": false
      },
      "realms_product": {
        "$comment": "Product section of the Realms GOS conductor gih4j-uaaaa-aaaap-quzya-cai (../realms/casals.json -e production); ck* are the DFINITY mainnet ledgers.",
        "marketplace_id": "gudgy-daaaa-aaaap-quz2a-cai",
        "nft_canister_id": "hxpp6-xyaaa-aaaap-quz4q-cai",
        "shared_tokens": {
          "RLM": {
            "ledger": "hqojk-2aaaa-aaaap-quz4a-cai",
            "indexer": "hqojk-2aaaa-aaaap-quz4a-cai",
            "decimals": 8
          },
          "ckBTC": {
            "ledger": "mxzaz-hqaaa-aaaar-qaada-cai",
            "indexer": "n5wcd-faaaa-aaaar-qaaea-cai",
            "decimals": 8
          },
          "ckUSDC": {
            "ledger": "xckus-ciaaa-aaaam-qbssa-cai",
            "indexer": "ufqgi-4qaaa-aaaam-qbsna-cai",
            "decimals": 6
          },
          "ckEURC": {
            "ledger": "pe5t5-diaaa-aaaar-qahwa-cai",
            "indexer": "pe5t5-diaaa-aaaar-qahwa-cai",
            "decimals": 6
          }
        }
      },
      "principals": {
        "operator": "rd4en-sizpv-vnamr-6vbfc-uljz5-vvz7c-g4nzy-uflq2-zbj3x-mrwjs-gqe",
        "signer_2": "5re5j-sqs53-usina-7u2ga-yioiv-vishn-4uw7j-y6l72-kvg73-ut2th-oqe",
        "signer_3": "55alf-xclhd-rtshz-lk4lo-wav4q-q3a5e-sktkm-zlshq-vvhjs-re6os-wae",
        "signer_4": "leedy-5gplf-ddm4v-22tvs-yhylw-rs4hz-6ezyu-udzyp-3jhnk-boliz-aae"
      },
      "cycles": {
        "min_balance_tc": 2.0,
        "budget_tc": 14
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "wasms": {
      "$comment": "WASM store (casals-wasms): the certified-assets canister every artifact Casals installs is served from (Casals issue #48). The operator stays a controller so `casals up` can upload into it — the deployer locally, prod-identity in production.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self",
        "$principal:operator"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "gaas",
      "reconcile_interval_secs": 30
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig"
      ]
    }
  },
  "domains": [
    {
      "host": "$env.portal_host",
      "canister": "realm-registry-frontend"
    }
  ],
  "registry": {
    "$comment": "Product wasms are built in this repo, ../realms and ../file-registry before `casals up` (local:; the exact recipes are the build steps of .github/workflows/gaas-e2e.yml); the conductor wasm by the Casals CLI (build:). Frontend dists are published as content namespaces. Production requires a sha256 pin on every row: run `casals pin casals.json` after building and commit the result.",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend",
        "sha256": "659f9c0d0a863a3ff839e572efd5e7ebe1e7bcec0999875662af08b97397abe9"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz",
        "sha256": "75df75f39763077fd0333b4ac46ba03b2b23ec313fa85f79a2097bd98bb363d1"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "local:../file-registry/.basilisk/ic_file_registry/ic_file_registry.wasm",
        "sha256": "fe216683b8d229f32ca0b1788637c56368aa4d8b462e2c5d52e63d21b62ed782"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "local:seed/templates/orchestration-multisig@1.6.0.wasm.gz",
        "sha256": "c8d3adecf9bea8d9e7811cfa5d9eda8f61723c770f85132b91c8b2cffb37974f"
      },
      {
        "family": "orchestration-baton",
        "version": "1.5.1",
        "source": "local:seed/templates/orchestration-baton@1.5.1.wasm.gz",
        "sha256": "2143faa8bc8e8e516ff065d30149ca2439aef733a0a23b8e104710e89a9b9ae1"
      },
      {
        "family": "certified-assets",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-frontend.wasm.gz",
        "sha256": "63d122d0149a29f4e48603efdd7d2bce656a6a83bac1e3207897c68e8e225bb6"
      },
      {
        "family": "realm-installer",
        "version": "main",
        "source": "local:.basilisk/realm_installer/realm_installer.wasm",
        "sha256": "7f3f1bc9b628c345b3d029d58b2f1fa131c0400a04eca6af0448744b3d389bed"
      },
      {
        "family": "realm-registry-backend",
        "version": "main",
        "source": "local:.basilisk/realm_registry_backend/realm_registry_backend.wasm",
        "sha256": "ab73950b693bc4877251d271fdf615430e3b7a4a747ef20c109a682f06731356"
      },
      {
        "family": "realm-backend",
        "version": "main",
        "source": "local:../realms/.basilisk/realm_backend/realm_backend.wasm",
        "sha256": "14a55a15b3a2a84a522227f1128547d4c630a385f86979ae08307e4a8f7b3e3d"
      },
      {
        "family": "token-backend",
        "version": "0.1.0",
        "source": "local:../realms/.external-wasms/token_backend.wasm",
        "sha256": "b3f1db3a3f6b928bdb00d49c9396c87004690e5a23a487384ba0c308ae7e685f"
      }
    ],
    "publish": [
      {
        "path": "frontend/realm-registry-frontend/main",
        "source": "local:src/realm_registry_frontend/dist"
      },
      {
        "path": "frontend/realm-assets/main",
        "source": "local:../realms/src/realm_frontend/dist"
      }
    ]
  },
  "sections": [
    {
      "name": "Infra",
      "description": "Realm installer, realm registry (the *.gos.earth portal) and the platform file registry.",
      "stands": [
        {
          "name": "file-registry",
          "description": "Platform artifact store (realm branding, extension packages, deployment manifests) — a GaaS product canister, not Casals' WASM store (that is conductor.wasms). Before the store existed it was the conductor's file_registry; the conductor re-homes that row here under the same canister id, so the data stays.",
          "canisters": [
            {
              "name": "file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "cycles": {
                "min_balance_tc": 2
              }
            }
          ]
        },
        {
          "name": "installer",
          "canisters": [
            {
              "name": "realm-installer",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-installer@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "registry_backend_id": "$canister:realm-registry-backend",
                    "file_registry_id": "$canister:file-registry",
                    "marketplace_id": "$env.realms_product.marketplace_id",
                    "nft_canister_id": "$env.realms_product.nft_canister_id",
                    "shared_tokens": "$env.realms_product.shared_tokens",
                    "casals_canister_id": "$self",
                    "casals_section": "Deployments",
                    "portal_url": "$env.portal_url",
                    "provision_via_casals": true
                  },
                  "converged_when": {
                    "query": "get_installer_config",
                    "equals_args": true
                  }
                }
              ],
              "health": [
                {
                  "query": "get_installer_config",
                  "expect": {
                    "success": true
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "realm-registry",
          "canisters": [
            {
              "name": "realm-registry-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-registry-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "portal_url": "$env.portal_url",
                    "can_test_mode": "$env.can_test_mode",
                    "installer_id": "$canister:realm-installer",
                    "casals_frontend_canister_id": "$canister:casals-frontend"
                  },
                  "converged_when": {
                    "query": "get_env_config",
                    "equals_args": true
                  }
                },
                {
                  "method": "set_canister_config_json",
                  "args": {
                    "casals_frontend_canister_id": "$canister:casals-frontend",
                    "network": "$env.network",
                    "test_flags": "$env.test_flags"
                  },
                  "converged_when": {
                    "query": "get_runtime_flags",
                    "contains": {
                      "casals_frontend_canister_id": "$canister:casals-frontend"
                    }
                  }
                }
              ]
            },
            {
              "name": "realm-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/realm-registry-frontend/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"realm_registry_backend\": \"$stand.backend\", \"realm_installer\": \"$canister:realm-installer\", \"casals_frontend\": \"$canister:casals-frontend\", \"network\": \"$env.network\", \"portal_url\": \"$env.portal_url\"};\n",
                "/.well-known/ii-alternative-origins": "$env.ii_alternative_origins"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Deployments",
      "description": "Realm stands. The installer calls create_stand({section, name, members}); the conductor builds the stand from this template on its next plan/apply and the installer configures the realm once get_bindings shows its canisters. A realm grows itself: its backend (stand commander) calls create_stand({name, members: [\"{stand}-quarter-{n}\"]}) and polls get_bindings.",
      "stand_template": {
        "name_pattern": "*",
        "created_by": "$canister:realm-installer",
        "baton": {
          "commanders": [
            {
              "principal": "$multisig",
              "weight": 2
            },
            "$self",
            "$stand.backend"
          ],
          "threshold": 2,
          "manages": [
            "backend",
            "frontend",
            "token",
            "quarter"
          ],
          "hand_off": true
        },
        "commanders": [
          {
            "principal": "$stand.backend",
            "permissions": "stand.create"
          }
        ],
        "canisters": [
          {
            "name": "{stand}-baton",
            "kind": "backend",
            "mode": "managed",
            "wasm": "orchestration-baton@1.5.1",
            "install_arg": {
              "top_commander": "$self"
            },
            "controllers": [
              "$multisig"
            ]
          },
          {
            "name": "{stand}-backend",
            "kind": "backend",
            "mode": "managed",
            "wasm": "realm-backend@main",
            "controllers": [
              "$self",
              "$multisig",
              "$canister:realm-installer"
            ]
          },
          {
            "name": "{stand}-frontend",
            "kind": "frontend",
            "mode": "managed",
            "wasm": "certified-assets@1.0.0",
            "controllers": [
              "$self",
              "$multisig",
              "$canister:realm-installer"
            ],
            "content": "frontend/realm-assets/main",
            "files": {
              "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_backend:\"$stand.backend\",internet_identity:\"https://identity.ic0.app\",file_registry:\"$canister:file-registry\",portal_url:\"${env.portal_url}/r/{stand}\",test_mode_ii_bypass:$env.test_flags.ii_bypass};\n"
            },
            "health": [
              {
                "http": "/index.html",
                "status": 200
              }
            ]
          },
          {
            "name": "{stand}-token",
            "kind": "backend",
            "mode": "managed",
            "wasm": "token-backend@0.1.0",
            "optional": true,
            "install_arg": "(record { name = \"{stand} Token\"; symbol = \"RLM\"; decimals = 8 : nat8; total_supply = 100_000_000_000_000_000 : nat; fee = 10_000 : nat; test = opt $env.can_test_mode; initial_owner = opt principal \"$stand.backend\" })",
            "controllers": [
              "$self",
              "$multisig"
            ]
          },
          {
            "name": "{stand}-quarter-{n}",
            "kind": "backend",
            "mode": "managed",
            "wasm": "realm-backend@main",
            "optional": true,
            "controllers": [
              "$self",
              "$multisig",
              "$stand.backend"
            ]
          }
        ]
      },
      "stands": []
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 5.0
  }
}
