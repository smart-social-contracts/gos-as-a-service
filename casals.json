{
  "version": 2,
  "name": "gaas",
  "description": "Governance Operating System-as-a-Service platform",
  "environments": {
    "production": {
      "network": "ic",
      "$comment": "operator is prod-identity (YubiKey). Deploy through an icp delegation from it (`prod-session`, docs/OPERATIONS.md, Hardware keys): the IC sees the same principal. DNS lives in the Cloudflare zone gos.earth; the API token is read from $CLOUDFLARE_API_TOKEN, never written here. The CLI does not write Cloudflare records yet (`reconcile_domains` reports unverifiable): per host add, DNS only (grey cloud), CNAME <host> -> <host>.icp1.io, TXT _canister-id.<host> -> <canister id from bindings>, CNAME _acme-challenge.<host> -> _acme-challenge.<host>.icp2.io, then POST https://icp0.io/custom-domains/v1/<host>.",
      "dns": {
        "provider": "cloudflare",
        "zone": "gos.earth",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "portal_url": "https://gos.earth",
      "gos_environment": "production",
      "casals_url": "https://casals.gos.earth",
      "principals": {
        "operator": "$deployer",
        "$comment": "Unclaimed access-code slot. Whoever redeems it becomes a conductor commander with full access. The code is not stored in this file.",
        "admin": "sha256:54f37582880030555448c7ff7b148ade534eb69df89c922a819189ec711aa9ed",
        "$comment_deployer": "The identity that ran casals up. It is a controller of the governance multisig only.",
        "deployer": "$deployer"
      },
      "realms_product": {
        "marketplace_id": "$orchestra:realms-product/marketplace-backend"
      },
      "cycles": {
        "budget_tc": 40
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "store": {
      "$comment": "WASM store",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      },
      {
        "principal": "$principal:admin",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "gaas"
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig",
        "$deployer"
      ]
    }
  },
  "domains": [
    {
      "host": "gos.earth",
      "canister": "realm-registry-frontend"
    },
    {
      "host": "casals.gos.earth",
      "canister": "casals-frontend"
    }
  ],
  "registry": {
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "release:smart-social-contracts/Casals@v0.4.0:casals_backend.wasm.gz",
        "sha256": "dc0f557f6b7cde042e643548e1c8ab4a5ce03748c86001bffccbb2bf9486ec1a"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "release:smart-social-contracts/Casals@v0.4.0:certified-assets@0.3.0.wasm.gz",
        "sha256": "75df75f39763077fd0333b4ac46ba03b2b23ec313fa85f79a2097bd98bb363d1"
      },
      {
        "family": "certified-assets",
        "version": "1.0.0",
        "source": "release:smart-social-contracts/Casals@v0.4.0:certified-assets@1.0.0.wasm.gz",
        "sha256": "63d122d0149a29f4e48603efdd7d2bce656a6a83bac1e3207897c68e8e225bb6"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "release:smart-social-contracts/Casals@v0.4.0:orchestration-multisig@1.6.0.wasm.gz",
        "sha256": "c8d3adecf9bea8d9e7811cfa5d9eda8f61723c770f85132b91c8b2cffb37974f"
      },
      {
        "family": "orchestration-baton",
        "version": "1.5.1",
        "source": "release:smart-social-contracts/Casals@v0.4.0:orchestration-baton@1.5.1.wasm.gz",
        "sha256": "2143faa8bc8e8e516ff065d30149ca2439aef733a0a23b8e104710e89a9b9ae1"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "release:smart-social-contracts/file-registry@v0.1.1:file_registry.wasm.gz",
        "sha256": "05ec042b1ed6944db2b3b69a781938f5f6ac5d7353490413b8b02b2149bd58e5"
      },
      {
        "family": "realm-installer",
        "version": "main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.4.0:realm_installer.wasm.gz",
        "sha256": "acfcfbd455523807f3e7b23b4e0710fed78c6440019c93a3505f4eeee61223f3"
      },
      {
        "family": "realm-registry-backend",
        "version": "main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.4.0:realm_registry_backend.wasm.gz",
        "sha256": "0257eb73d3c399608ca0570ec953ac543b92a4ead04a50d9b823956b4d2717ef"
      },
      {
        "family": "realm-backend",
        "version": "main",
        "source": "release:smart-social-contracts/realms-gos@v0.6.4:realm-backend-v0.6.4.wasm.gz",
        "sha256": "80d829121f3c0a82b1bb6eff257467894445abc8f2f9ad159caa75ebd550d4bf"
      }
    ],
    "bundles": [
      {
        "path": "frontend/realm-registry-frontend/main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.4.0:realm_registry_frontend.tar.gz",
        "sha256": "b1e85257a8afbd3782c64c00fd32df195bd696b250b71ad1e2d986f81a7e0a82"
      },
      {
        "path": "frontend/realm-assets/main",
        "source": "release:smart-social-contracts/realms-gos@v0.6.4:realm-frontend-v0.6.4.tar.gz",
        "sha256": "cc2ec08b0cb43c7572ec0cb3719d0d71e3c7b5827657b247b641f9ca1dc0d63e"
      },
      {
        "$comment": "Casals UI from the pinned Casals release. Ships with `casals upgrade --content frontend/casals-ui/main`.",
        "path": "frontend/casals-ui/main",
        "source": "release:smart-social-contracts/Casals@v0.4.0:casals_frontend.tar.gz",
        "sha256": "150292ea6d42d20d501f61356ed55efa4c095f5bbdcff3999450818929af768b"
      }
    ]
  },
  "sections": [
    {
      "name": "Infra",
      "description": "Realm installer, realm registry (the gos.earth portal) and the platform file registry.",
      "stands": [
        {
          "name": "file-registry",
          "description": "Platform artifact buffer (deployment temporary artifacts, such as manifests, etc.)",
          "canisters": [
            {
              "name": "file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "$comment": "Packages the installer fetches (ext/…, codex/…) are published here by the operator with `realms files publish`; controllers cannot upload.",
                  "method": "grant_publish",
                  "args": {
                    "namespace": "*",
                    "principal": "$principal:operator"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "*": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "$comment": "Portal branding uploads are signed by the end user, who becomes publisher of the fresh namespace (see realm_registry_frontend branding-upload.js).",
                  "method": "set_config",
                  "args": {
                    "auto_grant_publishers": true
                  },
                  "converged_when": {
                    "query": "get_config",
                    "equals_args": true
                  }
                },
                {
                  "$comment": "First-party listings on the Realms marketplace point at this registry; its review_listing stamps approvals here, so it must be an _approvers publisher.",
                  "method": "grant_publish",
                  "args": {
                    "namespace": "_approvers",
                    "principal": "$env.realms_product.marketplace_id"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "_approvers": [
                        "$env.realms_product.marketplace_id"
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "installer",
          "canisters": [
            {
              "name": "realm-installer",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-installer@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "registry_backend_id": "$canister:realm-registry-backend",
                    "file_registry_id": "$canister:file-registry",
                    "gos_environment": "$env.gos_environment",
                    "casals_canister_id": "$self",
                    "casals_section": "Deployments",
                    "portal_url": "$env.portal_url",
                    "provision_via_casals": true
                  },
                  "converged_when": {
                    "query": "get_installer_config",
                    "equals_args": true
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "realm-registry",
          "canisters": [
            {
              "name": "realm-registry-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-registry-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "portal_url": "$env.portal_url",
                    "installer_id": "$canister:realm-installer",
                    "casals_frontend_canister_id": "$canister:casals-frontend"
                  },
                  "converged_when": {
                    "query": "get_env_config",
                    "equals_args": true
                  }
                }
              ]
            },
            {
              "name": "realm-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/realm-registry-frontend/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_registry_backend:\"$stand.backend\",realm_installer:\"$canister:realm-installer\",file_registry:\"$canister:file-registry\",casals_backend:\"$canister:casals-backend\",network:\"$env.network\",portal_url:\"$env.portal_url\",casals_url:\"$env.casals_url\",gos_environment:\"$env.gos_environment\"};\n"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Deployments",
      "description": "Realm stands. The installer mints one with create_stand; the conductor builds it from this template and hands the backend, frontend, and quarters to the stand baton. A realm grows itself: its backend (a stand commander) calls create_stand for the next quarter.",
      "arrangements": {
       "stand_template": {
        "name_pattern": "*",
        "created_by": "$canister:realm-installer",
        "baton": {
          "commanders": [
            {
              "principal": "$multisig",
              "weight": 2
            },
            "$self",
            "$stand.backend"
          ],
          "threshold": 2,
          "manages": [
            "backend",
            "frontend",
            "quarter"
          ],
          "hand_off": "sole"
        },
        "commanders": [
          {
            "principal": "$stand.backend",
            "permissions": "stand.create"
          }
        ],
        "canisters": [
          {
            "name": "{stand}-baton",
            "kind": "backend",
            "mode": "managed",
            "wasm": "orchestration-baton@1.5.1",
            "install_arg": {
              "top_commander": "$self"
            },
            "controllers": [
              "$multisig"
            ]
          },
          {
            "name": "{stand}-backend",
            "kind": "backend",
            "mode": "managed",
            "wasm": "realm-backend@main",
            "install_arg": "(\"$canister:realm-installer\")",
            "controllers": [
              "$stand.baton",
              "$multisig",
              "$this"
            ]
          },
          {
            "name": "{stand}-frontend",
            "kind": "frontend",
            "mode": "managed",
            "wasm": "certified-assets@1.0.0",
            "controllers": [
              "$stand.baton",
              "$stand.backend"
            ],
            "grants": [
              {
                "principal": "$stand.backend",
                "permission": "Commit"
              }
            ],
            "content": "frontend/realm-assets/main",
            "files": {
              "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_backend:\"$stand.backend\",internet_identity:\"https://identity.ic0.app\"};\n"
            },
            "health": [
              {
                "http": "/index.html",
                "status": 200
              }
            ]
          },
          {
            "name": "{stand}-quarter-{n}",
            "kind": "backend",
            "mode": "managed",
            "wasm": "realm-backend@main",
            "install_arg": "(\"\")",
            "optional": true,
            "controllers": [
              "$stand.baton",
              "$multisig",
              "$this"
            ]
          }
        ]
        }
      },
      "stands": []
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
