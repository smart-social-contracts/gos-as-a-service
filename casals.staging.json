        "sha256": "c19e338ae32cf1f4c2c4c069183fe327dba18ddd665438cf09ea82ba0cbb1185"
      }
    ],
    "bundles": [
      {
        "path": "frontend/realm-registry-frontend/main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.3.4:realm_registry_frontend.tar.gz",
        "sha256": "6ba93fadb4f9055a1a744fe6b50cc408d47c65f19753d3bcde269afbf821e6d1"
      },
      {
        "path": "frontend/realm-assets/main",
        "source": "release:smart-social-contracts/realms@v0.5.2:realm_frontend.tar.gz",
        "sha256": "38b078371035e136e3863042026835c64ac2183d21bd4ea3abc35a72a0207c7b"
      },
      {
        "$comment": "Casals UI from the Casals v0.3.2 release. Ships with `casals upgrade --content frontend/casals-ui/main`.",
        "path": "frontend/casals-ui/main",
        "source": "release:smart-social-contracts/Casals@v0.3.3:casals_frontend.tar.gz",
        "sha256": "ddcbbcf11cefb2560cb8226f35f282b7f8652b70ef698173c910022342f25cdb"
      }
    ]
  },
  "sections": [
    {
      "name": "Infra",
      "description": "Realm installer, realm registry (the gos.earth portal) and the platform file registry.",
      "stands": [
        {
          "name": "file-registry",
          "description": "Platform artifact buffer (deployment temporary artifacts, such as manifests, etc.)",
          "canisters": [
            {
              "name": "file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ]
            }
          ]
        },
        {
          "name": "installer",
          "canisters": [
            {
              "name": "realm-installer",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-installer@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "registry_backend_id": "$canister:realm-registry-backend",
                    "file_registry_id": "$canister:file-registry",
                    "casals_canister_id": "$self",
                    "casals_section": "Deployments",
                    "portal_url": "$env.portal_url",
                    "provision_via_casals": true
                  },
                  "converged_when": {
                    "query": "get_installer_config",
                    "equals_args": true
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "realm-registry",
          "canisters": [
            {
              "name": "realm-registry-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-registry-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "configure",
                  "args": {
                    "portal_url": "$env.portal_url",
                    "installer_id": "$canister:realm-installer",
                    "casals_frontend_canister_id": "$canister:casals-frontend"
                  },
                  "converged_when": {
                    "query": "get_env_config",
                    "equals_args": true
                  }
                }
              ]
            },
            {
              "name": "realm-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/realm-registry-frontend/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_registry_backend:\"$stand.backend\",realm_installer:\"$canister:realm-installer\",file_registry:\"$canister:file-registry\",casals_backend:\"$canister:casals-backend\",network:\"$env.network\",portal_url:\"$env.portal_url\",casals_url:\"$env.casals_url\"};\n"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Deployments",
      "description": "Realm stands. The installer mints one with create_stand; the conductor builds it from this template and hands the backend, frontend, and quarters to the stand baton. A realm grows itself: its backend (a stand commander) calls create_stand for the next quarter.",
      "stand_template": {
        "name_pattern": "*",
        "created_by": "$canister:realm-installer",
        "baton": {
          "commanders": [
            {
              "principal": "$multisig",
              "weight": 2
            },
            "$self",
            "$stand.backend"
          ],
          "threshold": 2,
          "manages": [
            "backend",
            "frontend",
            "quarter"
          ],
          "hand_off": "sole"
        },
        "commanders": [
          {
            "principal": "$stand.backend",
            "permissions": "stand.create"
          }
        ],
        "canisters": [
          {
            "name": "{stand}-baton",
            "kind": "backend",
            "mode": "managed",
            "wasm": "orchestration-baton@1.5.1",
            "install_arg": {
              "top_commander": "$self"
            },
            "controllers": [
              "$multisig"
            ]
          },
          {
            "name": "{stand}-backend",
            "kind": "backend",
            "mode": "managed",
            "wasm": "realm-backend@main",
            "install_arg": "(\"$canister:realm-installer\")",
            "controllers": [
              "$stand.baton"
            ]
          },
          {
            "name": "{stand}-frontend",
            "kind": "frontend",
            "mode": "managed",
            "wasm": "certified-assets@1.0.0",
            "controllers": [
              "$stand.baton"
            ],
            "content": "frontend/realm-assets/main",
            "files": {
              "/canister_ids.js": "globalThis.__CANISTER_IDS={realm_backend:\"$stand.backend\",internet_identity:\"https://identity.ic0.app\"};\n"
            },
            "health": [
              {
                "http": "/index.html",
                "status": 200
              }
            ]
          },
          {
            "name": "{stand}-quarter-{n}",
            "kind": "backend",
            "mode": "managed",
            "wasm": "realm-backend@main",
            "install_arg": "(\"\")",
            "optional": true,
            "controllers": [
              "$stand.baton"
            ]
          }
        ]
      },
      "stands": []
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
