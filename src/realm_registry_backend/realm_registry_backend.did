type StableMemoryError = variant { OutOfMemory : null; OutOfBounds : null };
type StableGrowResult = variant { Ok : nat32; Err : variant { OutOfMemory : null; OutOfBounds : null } };
type Stable64GrowResult = variant { Ok : nat64; Err : variant { OutOfMemory : null; OutOfBounds : null } };
type RejectionCode = variant { NoError : null; SysFatal : null; SysTransient : null; DestinationInvalid : null; CanisterReject : null; CanisterError : null };
type NotifyResult = variant { Ok : null; Err : variant { NoError : null; SysFatal : null; SysTransient : null; DestinationInvalid : null; CanisterReject : null; CanisterError : null } };
type GuardResult = variant { Ok : null; Err : text };
type KeyTooLarge = record { given : nat32; max : nat32 };
type ValueTooLarge = record { given : nat32; max : nat32 };
type InsertError = variant { KeyTooLarge : record { given : nat32; max : nat32 }; ValueTooLarge : record { given : nat32; max : nat32 } };
type CreateCanisterArgs = record { settings : opt CanisterSettings };
type CanisterSettings = record { controllers : opt vec principal; compute_allocation : opt nat; memory_allocation : opt nat; freezing_threshold : opt nat };
type DefiniteCanisterSettings = record { controllers : vec principal; compute_allocation : nat; memory_allocation : nat; freezing_threshold : nat };
type CreateCanisterResult = record { canister_id : principal };
type UpdateSettingsArgs = record { canister_id : principal; settings : CanisterSettings };
type InstallCodeArgs = record { mode : InstallCodeMode; canister_id : principal; wasm_module : blob; arg : blob };
type InstallCodeMode = variant { install : null; reinstall : null; upgrade : null };
type UninstallCodeArgs = record { canister_id : principal };
type StartCanisterArgs = record { canister_id : principal };
type StopCanisterArgs = record { canister_id : principal };
type CanisterStatusArgs = record { canister_id : principal };
type CanisterStatusResult = record { status : CanisterStatus; settings : DefiniteCanisterSettings; module_hash : opt blob; memory_size : nat; cycles : nat };
type CanisterStatus = variant { running : null; stopping : null; stopped : null };
type DeleteCanisterArgs = record { canister_id : principal };
type DepositCyclesArgs = record { canister_id : principal };
type ProvisionalCreateCanisterWithCyclesArgs = record { amount : opt nat; settings : opt CanisterSettings };
type ProvisionalCreateCanisterWithCyclesResult = record { canister_id : principal };
type ProvisionalTopUpCanisterArgs = record { canister_id : principal; amount : nat };
type HttpMethod = variant { get : null; head : null; post : null };
type HttpHeader = record { name : text; value : text };
type HttpResponse = record { status : nat; headers : vec HttpHeader; body : blob };
type HttpTransformArgs = record { response : HttpResponse; context : blob };
type HttpTransformFunc = func (HttpTransformArgs) -> (HttpResponse) query;
type HttpTransform = record { function : HttpTransformFunc; context : blob };
type HttpRequestArgs = record { url : text; max_response_bytes : opt nat64; method : HttpMethod; headers : vec HttpHeader; body : opt blob; transform : opt HttpTransform };
type EcdsaCurve = variant { secp256k1 : null };
type KeyId = record { curve : EcdsaCurve; name : text };
type EcdsaPublicKeyArgs = record { canister_id : opt principal; derivation_path : vec blob; key_id : KeyId };
type SignWithEcdsaArgs = record { message_hash : blob; derivation_path : vec blob; key_id : KeyId };
type EcdsaPublicKeyResult = record { public_key : blob; chain_code : blob };
type SignWithEcdsaResult = record { signature : blob };
type Satoshi = nat64;
type MillisatoshiPerByte = nat64;
type BitcoinAddress = text;
type BlockHash = blob;
type Page = blob;
type BitcoinNetwork = variant { Mainnet : null; Regtest : null; Testnet : null };
type GetBalanceArgs = record { address : text; min_confirmations : opt nat32; network : BitcoinNetwork };
type GetCurrentFeePercentilesArgs = record { network : BitcoinNetwork };
type UtxosFilter = variant { MinConfirmations : nat32; Page : blob };
type GetUtxosArgs = record { address : text; filter : opt UtxosFilter; network : BitcoinNetwork };
type Outpoint = record { txid : blob; vout : nat32 };
type Utxo = record { height : nat32; outpoint : Outpoint; value : nat64 };
type GetUtxosResult = record { next_page : opt blob; tip_block_hash : blob; tip_height : nat32; utxos : vec Utxo };
type SendTransactionArgs = record { transaction : blob; network : BitcoinNetwork };
type SendTransactionError = variant { MalformedTransaction : null; QueueFull : null };
type Tokens = record { e8s : nat64 };
type TimeStamp = record { timestamp_nanos : nat64 };
type TransferArgs = record { memo : nat64; amount : Tokens; fee : Tokens; from_subaccount : opt blob; to : blob; created_at_time : opt TimeStamp };
type TransferError_BadFee = record { expected_fee : Tokens };
type TransferError_InsufficientFunds = record { balance : Tokens };
type TransferError_TxTooOld = record { allowed_window_nanos : nat64 };
type TransferError_TxDuplicate = record { duplicate_of : nat64 };
type TransferError = variant { BadFee : TransferError_BadFee; InsufficientFunds : TransferError_InsufficientFunds; TxTooOld : TransferError_TxTooOld; TxCreatedInFuture : null; TxDuplicate : TransferError_TxDuplicate };
type TransferResult = variant { Ok : nat64; Err : TransferError };
type AccountBalanceArgs = record { account : blob };
type TransferFeeArg = record { };
type TransferFee = record { transfer_fee : Tokens };
type AccountIdentifier = blob;
type SubAccount = blob;
type BlockIndex = nat64;
type Memo = nat64;
type Address = text;
type GetBlocksArgs = record { start : nat64; length : nat64 };
type Operation_Mint = record { to : blob; amount : Tokens };
type Operation_Burn = record { from : blob; amount : Tokens };
type Operation_Transfer = record { from : blob; to : blob; amount : Tokens; fee : Tokens };
type Operation = variant { Mint : Operation_Mint; Burn : Operation_Burn; Transfer : Operation_Transfer };
type Transaction = record { memo : nat64; operation : opt Operation; created_at_time : TimeStamp };
type Block = record { parent_hash : opt blob; transaction : Transaction; timestamp : TimeStamp };
type BlockRange = record { blocks : vec Block };
type QueryArchiveError_BadFirstBlockIndex = record { requested_index : nat64; first_valid_index : nat64 };
type QueryArchiveError_Other = record { error_code : nat64; error_message : text };
type QueryArchiveError = variant { BadFirstBlockIndex : QueryArchiveError_BadFirstBlockIndex; Other : QueryArchiveError_Other };
type QueryArchiveResult = variant { Ok : BlockRange; Err : QueryArchiveError };
type QueryArchiveFn = func (GetBlocksArgs) -> (QueryArchiveResult) query;
type QueryBlocksResponse_archived_blocks = record { start : nat64; length : nat64; callback : QueryArchiveFn };
type QueryBlocksResponse = record { chain_length : nat64; certificate : opt blob; blocks : vec Block; first_block_index : nat64; archived_blocks : vec QueryBlocksResponse_archived_blocks };
type Archive = record { canister_id : principal };
type Archives = record { archives : vec Archive };
type SymbolResult = record { symbol : text };
type NameResult = record { name : text };
type DecimalsResult = record { decimals : nat32 };
type RInstallerError = record { message : text; traceback : text };
type REnqueueOk = record { job_id : text; status : text; realm_name : text; network : text };
type RProvisionOk = record { job_id : text; status : text; stand : text; backend_canister_id : text; frontend_canister_id : text };
type UserCreditsRecord = record { principal_id : text; balance : nat64; total_purchased : nat64; total_spent : nat64 };
type CreditTransactionRecord = record { id : text; principal_id : text; amount : nat64; transaction_type : text; description : text; stripe_session_id : text; timestamp : float64 };
type RealmRecord = record { id : text; name : text; url : text; backend_url : text; logo : text; users_count : nat64; created_at : float64; frontend_canister_id : text; listing_status : text };
type StatusRecord = record { version : text; commit : text; commit_datetime : text; status : text; realms_count : nat64; dependencies : vec text; python_version : text };
type BillingStatusRecord = record { users_count : nat64; total_balance : nat64; total_purchased : nat64; total_spent : nat64 };
type VersionInfoRecord = record { version : text; backend_wasm_url : text; frontend_tar_url : text; backend_wasm_hash : text; frontend_tar_hash : text; published_at : float64 };
type Header = record { 0 : text; 1 : text };
type HttpRequest = record { method : text; url : text; headers : vec Header; body : blob };
type HttpResponseIncoming = record { status_code : nat16; headers : vec Header; body : blob; streaming_strategy : opt text; upgrade : opt bool };
type InstallerError = record { message : text; traceback : text };
type DeploymentJobView = record { job_id : text; status : text; realm_name : text; caller_principal : text; network : text; backend_canister_id : text; frontend_canister_id : text; expected_wasm_hash : text; actual_wasm_hash : text; wasm_verified : int8; assets_verified : int8; frontend_wasm_verified : int8; ext_deploy_task_id : text; expected_step_count : nat32; registry_canister_id : text; error : text; created_at : nat64; completed_at : nat64 };
type DeployStepView = record { idx : nat32; kind : text; label : text; status : text; error : text };
type DeployTaskView = record { task_id : text; status : text; steps : vec DeployStepView; completed_count : nat32; total_count : nat32 };
type PendingJobEntry = record { job : DeploymentJobView; manifest : text };
type PendingJobsOk = record { jobs : vec PendingJobEntry; count : nat32 };
type JobsListOk = record { jobs : vec DeploymentJobView; count : nat32 };
type EnqueueOk = record { job_id : text; status : text; realm_name : text; network : text };
type JobStatusAck = record { job_id : text; prev_status : text; status : text; noop : bool };
type ReportReadyOk = record { job_id : text; status : text; wasm_verified : bool; actual_wasm_hash : text; extensions_started : bool; expected_wasm_hash : text; failed_verification : bool };
type ReportFrontendOk = record { job_id : text; status : text; actual_assets_hash : text; assets_verified : int8; actual_frontend_wasm_hash : text; frontend_wasm_verified : bool; failed_verification : bool };
type PublicLogEntry = record { timestamp : nat; level : text; logger_name : text; message : text; id : nat };
type HealthView = record { ok : bool; canister : text };
type TakeSnapshotOk = record { job_id : text; snapshot_id : text; skipped : bool };
type ProvisionOk = record { job_id : text; status : text; stand : text; backend_canister_id : text; frontend_canister_id : text };
type CasalsConfigView = record { provision_via_casals : bool; casals_canister_id : text; casals_section : text; registry_principal : text; create_stand_baton : bool; baton_wasm_key : text };
type RResultEnqueue = variant { Ok : REnqueueOk; Err : RInstallerError };
type RResultProvision = variant { Ok : RProvisionOk; Err : RInstallerError };
type GetCreditsResult = variant { Ok : UserCreditsRecord; Err : text };
type AddCreditsResult = variant { Ok : UserCreditsRecord; Err : text };
type DeductCreditsResult = variant { Ok : UserCreditsRecord; Err : text };
type TransactionHistoryResult = variant { Ok : vec CreditTransactionRecord; Err : text };
type AddRealmResult = variant { Ok : text; Err : text };
type GetRealmResult = variant { Ok : RealmRecord; Err : text };
type GetStatusResult = variant { Ok : StatusRecord; Err : text };
type GetBillingStatusResult = variant { Ok : BillingStatusRecord; Err : text };
type UpgradeResult = variant { Ok : text; Err : text };
type GenericResult = variant { Ok : text; Err : text };
type ResultDeployTaskStatus = variant { Ok : DeployTaskView; Err : InstallerError };
type ResultPendingJobs = variant { Ok : PendingJobsOk; Err : InstallerError };
type ResultJobsList = variant { Ok : JobsListOk; Err : InstallerError };
type ResultEnqueue = variant { Ok : EnqueueOk; Err : InstallerError };
type ResultJobIdStatus = variant { Ok : DeploymentJobView; Err : InstallerError };
type ResultJobManifest = variant { Ok : text; Err : InstallerError };
type ResultJobCancel = variant { Ok : JobStatusAck; Err : InstallerError };
type ResultReportFailure = variant { Ok : JobStatusAck; Err : InstallerError };
type ResultReportReady = variant { Ok : ReportReadyOk; Err : InstallerError };
type ResultReportFrontend = variant { Ok : ReportFrontendOk; Err : InstallerError };
type ResultTakeSnapshot = variant { Ok : TakeSnapshotOk; Err : InstallerError };
type ResultProvision = variant { Ok : ProvisionOk; Err : InstallerError };
type ResultCasalsConfig = variant { Ok : CasalsConfigView; Err : InstallerError };
type RealmInstallerService = service { enqueue_deployment : (text) -> (RResultEnqueue); cancel_deployment : (text) -> (text); provision_via_casals : (text) -> (RResultProvision) };
type RealmTargetService = service { install_extension_from_registry : (text) -> (text); install_codex_from_registry : (text) -> (text); resync_extension_frontends : (text) -> (text) };
type RealmRegistryService = service { register_realm : (text, text, text, text, text) -> (text); remove_realm : (text) -> (text); deployment_failed : (text, text, text) -> (text); deployment_succeeded : (text, text) -> (text) };
type FileRegistryService = service { get_extension_manifest : (text) -> (text) query };
type CasalsService = service { get_tree : () -> (text) query; get_cycles_cached : () -> (text) query; create_stand : (text) -> (text); create_canister : (text) -> (text); set_commander : (text) -> (text); upgrade_to : (text) -> (text); orchestration_hand_to_baton : (text) -> (text); orchestration_configure_baton : (text) -> (text); destroy_stand : (text) -> (text) };

service : (text) -> {
  "status" : () -> (GetStatusResult) query;
  "http_request" : (HttpRequest) -> (HttpResponseIncoming) query;
  "http_request_update" : (HttpRequest) -> (HttpResponseIncoming);
  "list_realms" : () -> (vec RealmRecord) query;
  "register_realm" : (text, text, text, text, text) -> (AddRealmResult);
  "get_realm" : (text) -> (GetRealmResult) query;
  "remove_realm" : (text) -> (AddRealmResult);
  "realm_count" : () -> (nat64) query;
  "realm_setup_completed" : (text) -> (text);
  "claim_slug" : (text, text, text, text, text, opt text, opt text, opt text, opt text) -> (GenericResult);
  "resolve_slug" : (text) -> (GenericResult);
  "list_pending_pretty_hostnames" : () -> (text) query;
  "set_pretty_hostname_status" : (text, text) -> (GenericResult);
  "get_credits" : (text) -> (GetCreditsResult) query;
  "add_credits" : (text, nat64, text, text) -> (AddCreditsResult);
  "deduct_credits" : (text, nat64, text) -> (DeductCreditsResult);
  "get_transactions" : (text, nat64) -> (TransactionHistoryResult) query;
  "billing_status" : () -> (GetBillingStatusResult) query;
  "request_deployment" : (text) -> (text);
  "deployment_failed" : (text, text, text) -> (text);
  "deployment_succeeded" : (text, text) -> (text);
  "publish_version" : (text) -> (UpgradeResult);
  "get_latest_version" : () -> (UpgradeResult) query;
  "list_versions" : () -> (text) query;
  "request_upgrade" : (text) -> (text);
  "get_invitation_mode" : () -> (GenericResult) query;
  "is_principal_activated" : (text) -> (GenericResult) query;
  "redeem_invitation_code" : (text) -> (GenericResult);
  "set_invitation_mode" : (text) -> (GenericResult);
  "create_invitation_codes" : (text) -> (GenericResult);
  "revoke_invitation_code" : (text) -> (GenericResult);
  "deactivate_principal" : (text) -> (GenericResult);
  "list_invitation_codes" : () -> (text) query;
  "list_activated_principals" : () -> (text) query;
  "configure" : (text) -> (GenericResult);
  "get_env_config" : () -> (text) query;
  "get_runtime_flags" : () -> (text) query;
  "set_canister_config_json" : (text) -> (text);
  "set_test_flags_json" : (text) -> (text);
  "__shell__" : (text) -> (text);
  "__browse__" : (text) -> (text) query;
  "__get_candid_interface_tmp_hack" : () -> (text) query;
}
